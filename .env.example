# Copy to .env and adjust. Values here override the docker-compose defaults.
SECRET_KEY=change-me-to-a-long-random-string
# Any private network address (192.168.x.x, 10.x.x.x, ...) is accepted automatically, so tablets can use
# the church computer's LAN address. List extra names here only (e.g. a domain).
ALLOWED_HOSTS=localhost,127.0.0.1
# PRIVATE_NETWORK_HOSTS=true
# CSRF_TRUSTED_ORIGINS=https://chms.bbcbarani.org
# SECURE_COOKIES=true
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
# Production only:
# POSTGRES_PASSWORD=change-me
# Dev only: set false to start with an empty database
# SEED_DEMO=true
# Phase 2 self check-in (QR, fingerprint, face): set false to hide all of it.
# Single modes are switched in the app: Self check-in > Modes (QR is on by default).
# SELF_CHECKIN_ENABLED=true
